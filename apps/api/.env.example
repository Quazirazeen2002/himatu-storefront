NODE_ENV=development
PORT=4000
WEB_ORIGIN=http://localhost:3000
# Runtime: Supabase transaction pooler port 6543; URL-encode passwords.
DATABASE_URL=
# Migration: direct connection when IPv6 available, otherwise session pooler port 5432.
DIRECT_URL=
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=
# Reserved for trusted administrative operations; not required by customer requests.
SUPABASE_SECRET_KEY=
SUPABASE_JWT_ISSUER=https://YOUR_PROJECT.supabase.co/auth/v1
# Only enable for an existing HS256 project. Prefer asymmetric signing keys.
SUPABASE_LEGACY_JWT=false

# Public CA certificate downloaded from Supabase Database Settings (for verified TLS).
DATABASE_SSL_CA_PATH=certs/supabase-ca.crt
# Server-only SMTP used for reviewed invoice emails and optional Supabase SMTP setup.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_SENDER_EMAIL=
SMTP_SENDER_NAME=HIMATU
SMTP_PASSWORD=
