# Server-only; never prefix secrets or database credentials with NEXT_PUBLIC_.
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=

# Local-only aliases (localhost/127.0.0.1/::1), gated by a loopback APP_URL.
AUTH_ALLOW_LOCAL_ORIGINS=true
# Optional exact trusted origins, comma-separated; never use a wildcard.
AUTH_ALLOWED_ORIGINS=
